{
  "name": "generic-acp-agent",
  "version": "0.1.0",
  "description": "Vendor-neutral ACP agent bridging JetBrains AI Assistant to any OpenAI-compatible API",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "generic-acp-agent": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^7.12.1",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
